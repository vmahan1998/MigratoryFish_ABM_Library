# ============================================================
#  create_word_template.R
#  Run once to generate word_template.docx with aquatic theme
# ============================================================
if (!requireNamespace("officer", quietly = TRUE)) install.packages("officer")
library(officer)
# ------------------------------------------------------------
# Color palette matching aquatic bookdown theme
# ------------------------------------------------------------
col_navy   <- "#0a3d62"
col_blue   <- "#0c7aba"
col_bright <- "#1e90ff"
col_light  <- "#f0f8ff"
col_text   <- "#1a1a1a"
col_white  <- "#ffffff"
# ------------------------------------------------------------
# Create document
# ------------------------------------------------------------
doc <- read_docx()
# ------------------------------------------------------------
# Modify Normal style — body text
# ------------------------------------------------------------
doc <- change_styles(
doc,
style_type = "paragraph",
style_id   = "Normal",
fp_t = fp_text(
font.family = "Calibri",
font.size   = 11,
color       = col_text
),
fp_p = fp_par(
line_spacing = 1.15,
space_after  = 8
)
)
