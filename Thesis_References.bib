@misc{quintana_penobscot_2026,
	title = {Penobscot {Mercury} {Exposure} {Model} ({P}-{MEM})},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://zenodo.org/doi/10.5281/zenodo.19483469},
	doi = {10.5281/ZENODO.19483469},
	abstract = {The Penobscot Mercury Exposure Model (P-MEM) is a coupled hydrodynamic–agent-based modeling framework developed to quantify sediment-bound contaminant exposure risk in anadromous fish within estuarine systems. The model integrates high-resolution hydrodynamic outputs based on real environmental conditions with mechanistic representations of fish behavior and physiology to simulate how contaminant exposure emerges through time and space.

P-MEM is designed to move beyond static representations of contamination by explicitly linking environmental conditions, organismal processes, and behavioral interactions. Within the model, contaminant exposure is not treated as a fixed property of location, but as a dynamic outcome determined by when contaminated material becomes available, where fish can occupy suitable habitat, and how individuals move through and interact with that environment.},
	urldate = {2026-04-09},
	publisher = {Zenodo},
	author = {Quintana, Vanessa and Huguenard, Kimberly and Swannack, Todd},
	month = apr,
	year = {2026},
	note = {Version Number: beta},
	keywords = {agent-based model, anadromous fish, Bioaccumulation, Bioaccumulation/physiology, contaminant exposure, coupled models, ecological modeling, environmental risk assessment, estuarine systems, fish migration, fish toxicity, Mercury contamination, methylmercury (MeHg), river herring, Sediment transport, suspended particulate matter (SPM)},
}

